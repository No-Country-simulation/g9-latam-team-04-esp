# Con el prefijo "TK_", sabemos que es de TechMind 🧠. Es una convención.
# El nombre de la variable de entorno es TK_ + nombre del atributo 'debug: bool = False' en mayúsculas.

# Modo desarrollo: true => uvicorn --reload activo
TK_DEBUG=false

# Orígenes permitidos para CORS (formato JSON array)
TK_CORS_ORIGINS=["*"]

# Modelos de clasificación, rutas a los archivos .joblib
TK_MODEL_PATH_EN=data-science/models/modelo_clasificador_en.joblib
TK_VECTORIZER_PATH_EN=data-science/models/vectorizador_en.joblib
TK_MODEL_PATH_ES=data-science/models/modelo_clasificador_es.joblib
TK_VECTORIZER_PATH_ES=data-science/models/vectorizador_es.joblib

# Oracle Database
TK_ORACLE_USER=
TK_ORACLE_PASSWORD=
TK_ORACLE_DSN= # alias dentro del archivo tnsnames.ora
TK_ORACLE_WALLET_DIR= # carpeta donde extrajeron el .zip
TK_ORACLE_WALLET_PASSWORD=

# OCI Object Storage
TK_OCI_ENABLED=false
# TK_OCI_CONFIG_PATH=
# TK_OCI_BUCKET_NAME=
# TK_OCI_NAMESPACE=

# Comportamiento por defecto ("auto" detecta idioma, "en" o "es" fuerza el modelo)
TK_DEFAULT_LANGUAGE=auto

# Configuración de Reentrenamiento
TK_RETRAIN_MIN_FEEDBACK=50
TK_RETRAIN_MIN_F1_IMPROVEMENT=0.02

# Recarga en caliente de modelos (segundos entre chequeos; 0 = deshabilitado)
TK_RELOAD_CHECK_INTERVAL_S=86400

# Token administrador requerido en header X-Admin-Token para POST /modelos/reentrenar
# Si queda vacío, los endpoints de gestión permanecen deshabilitados.
TK_ADMIN_TOKEN=
