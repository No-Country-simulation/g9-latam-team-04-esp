# Entorno de producción. En este contexto, conviene copiar este archivo, pegarlo en este proyecto de nuevo (en la raíz), y llamarlo sólo ".env".
# Además, hay que agregar el propio nombre y contraseña.
# Con el prefijo "TK_", sabemos que es de TechKnowledge. Es una convención.
# El nombre de la variable de entorno es TK_ + nombre del atributo 'debug: bool = False' en mayúsculas.

# ── Configuración del Frontend ──
# URL del backend para el frontend (CAMBIAR SEGÚN INFRAESTRUCTURA)
TK_BE_URL=https://api.tu-dominio.com
# O si backend y frontend están en el mismo servidor:
# TK_BE_URL=http://localhost:8000
# O si backend está en servidor diferente:
# TK_BE_URL=http://IP_DEL_SERVIDOR:8000

# ── Configuración del Backend ──
# Modo desarrollo: false para producción
TK_DEBUG=false

# Orígenes permitidos para CORS (CAMBIAR al dominio real del frontend)
TK_CORS_ORIGINS=["https://tu-dominio.com"]

# Host y puerto del servidor FastAPI
TK_HOST=0.0.0.0
TK_PORT=8000

# ── Modelos de Clasificación ──
# Rutas a los archivos .joblib (descomentar si se usan rutas personalizadas)
# TK_MODEL_PATH_EN=data-science/models/en/model_en.joblib
# TK_VECTORIZER_PATH_EN=data-science/models/en/vectorizer_en.joblib
# TK_MODEL_PATH_ES=data-science/models/es/model_es.joblib
# TK_VECTORIZER_PATH_ES=data-science/models/es/vectorizer_es.joblib

# ── Oracle Database (Producción - OCI Autonomous Database) ──
# COORDINAR CON EQUIPO PARA OBTENER CREDENCIALES REALES
TK_ORACLE_USER=USERNAME_SCHEMA_SGOEJ
TK_ORACLE_PASSWORD=
TK_ORACLE_DSN=tcps://db.freesql.com:2484/23ai_34ui2
TK_ORACLE_WALLET_DIR=
TK_ORACLE_WALLET_PASSWORD=

# ── OCI Object Storage ──
TK_OCI_ENABLED=false
# TK_OCI_CONFIG_PATH=
TK_OCI_BUCKET_NAME=techknowledge-models
# TK_OCI_NAMESPACE=

# ── Comportamiento por Defecto ──
# Lenguaje por defecto ("auto" detecta idioma, "en" o "es" fuerza el modelo)
TK_DEFAULT_LANGUAGE=auto
