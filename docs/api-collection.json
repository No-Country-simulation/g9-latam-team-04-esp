            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/contenido/lote-csv",
          "host": ["{{baseUrl}}"],
          "path": ["contenido", "lote-csv"]
        },
        "description": "Procesa un archivo CSV con múltiples contenidos para clasificar e insertar en lote."
      }
    },
    {
      "name": "Listar / Buscar Historial",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/historial?limite=10&pagina=1",
          "host": ["{{baseUrl}}"],
          "path": ["historial"],
          "query": [
            { "key": "limite", "value": "10" },
            { "key": "pagina", "value": "1" }
          ]
        },
        "description": "Lista o busca los contenidos procesados y almacenados en la base de datos."
      }
    },
    {
      "name": "Búsqueda Semántica",
      "request": {
        "method": "POST",
