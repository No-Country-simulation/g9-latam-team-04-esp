      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"titulo\": \"Introducción a FastAPI\",\n    \"texto\": \"Creación de APIs asíncronas de alto rendimiento con Python 3.13.\"\n  },\n  {\n    \"titulo\": \"Modelos de Embeddings\",\n    \"texto\": \"Uso de SentenceTransformers para representaciones vectoriales.\"\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/contenido/lote-json",
          "host": ["{{baseUrl}}"],
          "path": ["contenido", "lote-json"]
        },
        "description": "Clasifica un arreglo de objetos JSON en procesamiento por lotes."
      }
    },
    {
      "name": "Clasificar Lote desde CSV",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
