        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Optimización de consultas SQL en Oracle\",\n  \"texto\": \"Cómo utilizar índices y análisis de planes de ejecución para mejorar el rendimiento.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/contenido",
          "host": ["{{baseUrl}}"],
          "path": ["contenido"]
        },
        "description": "Clasifica un contenido técnico individual generando sus embeddings y almacenándolo."
      }
    },
    {
