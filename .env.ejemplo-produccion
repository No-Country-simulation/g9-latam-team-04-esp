# Entorno de producción. En este contexto, conviene copiar este archivo, pegarlo en este proyecto de nuevo (en la raíz), y llamarlo sólo ".env".
# Además, hay que agregar el propio nombre y contraseña.
# Con el prefijo "TK_", sabemos que es de TechKnowledge. Es una convención.
# El nombre de la variable de entorno es TK_ + nombre del atributo 'debug: bool = False' en mayúsculas.

# NOTA: Las variables PYTHONDONTWRITEBYTECODE y PYTHONUNBUFFERED están en el Dockerfile
# ya que son buenas prácticas universales para contenedores Python.

# ── Configuración del Frontend ──
# URL del backend para el frontend (CAMBIAR SEGÚN INFRAESTRUCTURA)
TK_BE_URL=http://localhost:8000

# ── Configuración del Backend ──
# Modo desarrollo: false para producción (desactiva uvicorn --reload)
TK_DEBUG=false

# Orígenes permitidos para CORS (CAMBIAR al dominio real del frontend)
TK_CORS_ORIGINS=["http://localhost:5500", "http://127.0.0.1:5500"]

# Host y puerto del servidor FastAPI
TK_HOST=0.0.0.0
TK_PORT=8000

# Modelos de Clasificación ── Rutas a los archivos .joblib (comentar si se usan rutas personalizadas)
TK_MODEL_PATH_EN=data-science/models/en/model_en.joblib
TK_VECTORIZER_PATH_EN=data-science/models/en/vectorizer_en.joblib
TK_MODEL_PATH_ES=data-science/models/es/model_es.joblib
TK_VECTORIZER_PATH_ES=data-science/models/es/vectorizer_es.joblib

# Oracle Database (Producción - OCI Autonomous Database) ── CAMBIAR CONFIGURACIÓN SEGÚN SEA NECESARIO SI LO AMERITA
TK_ORACLE_USER=
TK_ORACLE_PASSWORD=
TK_ORACLE_DSN=
TK_ORACLE_WALLET_DIR=/app/oracle-wallet
TK_ORACLE_WALLET_PASSWORD=tu_password_wallet

# OCI Object Storage
TK_OCI_ENABLED=false
TK_OCI_CONFIG_PATH=
TK_OCI_BUCKET_NAME=
TK_OCI_NAMESPACE=

# ── Comportamiento por Defecto ──
# Lenguaje por defecto ("auto" detecta idioma, "en" o "es" fuerza el modelo)
TK_DEFAULT_LANGUAGE=auto

# ── Umbrales y límites de la API ──
TK_CONFIANZA_MINIMA=0.25
TK_LOTE_MAXIMO=100
TK_PAGINACION_MAXIMA=100
TK_PAGINACION_DEFECTO=20

# ── Configuración del clasificador ──
TK_TERMINOS_CLAVE_MAXIMOS=5
TK_DETECCION_IDIOMA_MAX_CHARS=500

# ── Configuración de validación ──
TK_VALIDACION_MIN_LONGITUD=5
TK_VALIDACION_MAX_RUIDO=0.8

# Configuración de Reentrenamiento
TK_RETRAIN_MIN_FEEDBACK=50
TK_RETRAIN_MIN_F1_IMPROVEMENT=0.02

# Recarga en caliente de modelos (segundos entre chequeos; 0 = deshabilitado)
TK_RELOAD_CHECK_INTERVAL_S=5

# Token administrador requerido en header X-Admin-Token para POST /modelos/reentrenar
# Si queda vacío, los endpoints de gestión permanecen deshabilitados.
